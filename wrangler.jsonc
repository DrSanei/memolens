{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memolens",
  "compatibility_date": "2026-08-24",
  "main": "./worker/index.ts",
  "secrets": {
    "required": [
      "KPI_PASSWORD",
      "KPI_SESSION_SECRET",
      "SUPABASE_SECRET_KEY",
      "SUPABASE_URL"
    ]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}

