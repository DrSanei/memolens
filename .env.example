VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# direct: browser writes through Supabase RLS (default)
# edge: browser calls the included validated Edge Function
VITE_RESEARCH_TRANSPORT=direct
VITE_SUPABASE_EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/ingest

# Optional for GitHub Pages project sites, for example /memolens/
VITE_BASE_PATH=/
